# Encrypts the secrets file (API keys, Gmail tokens, IMAP app password) in the data volume.
# Generate one with:  openssl rand -base64 32
# Keep it outside the data volume (this file, a Docker secret or your password manager).
JOBHUNTER_MASTER_KEY=
# Optional: your public URL if you expose Jobhunter behind a reverse proxy (used for the Gmail OAuth redirect).
# JOBHUNTER_PUBLIC_URL=https://jobhunter.example.ts.net
