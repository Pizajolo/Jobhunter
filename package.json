{
  "name": "jobhunter",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI job-search assistant",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @jobhunter/engine --filter @jobhunter/web dev",
    "build": "pnpm -r --filter=!@jobhunter/desktop build",
    "build:desktop": "pnpm --filter @jobhunter/desktop build",
    "start": "pnpm --filter @jobhunter/engine start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prompts": "pnpm --filter @jobhunter/engine test:prompts",
    "eval:email": "pnpm --filter @jobhunter/engine eval:email",
    "e2e": "pnpm --filter @jobhunter/e2e test",
    "db:generate": "pnpm --filter @jobhunter/db generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
